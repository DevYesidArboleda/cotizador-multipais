#!/bin/sh
# Sourced por el entrypoint oficial de Nginx antes de envsubst.
# Toma el DNS del contenedor (Docker: 127.0.0.11, Render: el suyo) para resolver STRAPI_UPSTREAM en runtime.
ns=$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf)
case "$ns" in
  *:*) ns="[$ns]" ;;
esac
export NGINX_RESOLVER="${NGINX_RESOLVER:-${ns:-127.0.0.11}}"
