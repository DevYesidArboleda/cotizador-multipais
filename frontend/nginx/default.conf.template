# Plantilla procesada por envsubst (imagen oficial de Nginx). Variables: ${PORT}, ${STRAPI_UPSTREAM}, ${NGINX_RESOLVER}.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
  set $strapi_upstream ${STRAPI_UPSTREAM};

  # Cabeceras de seguridad (se repiten en cada location con add_header propio)
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Proxy SOLO de la API de contenido. /admin de Strapi nunca se expone por este origen (ADR-002).
  location /api/ {
    limit_except GET HEAD OPTIONS { deny all; }
    proxy_pass $strapi_upstream;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 70s;
  }

  # Assets con hash: caché inmutable
  location ~* \.(?:js|css|woff2?|svg|png|jpg|ico)$ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
  }

  # SPA: rutas /co/quote/step-1, /cl/quote/step-2, ...
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  }
}
