HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# URL publica (server.url y CORS)
PUBLIC_URL=http://localhost:1337

# Base de datos: sqlite (local/Docker) o postgres (nube)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_URL=postgres://usuario:clave@host:5432/db
# DATABASE_SSL=true

# Seed CO/CL idempotente y no destructivo
SEED_ON_BOOT=true

# Admin inicial (solo si no hay admins). Valores ficticios en local; Secrets en la nube.
# STRAPI_ADMIN_EMAIL=admin@example.com
# STRAPI_ADMIN_PASSWORD=
