# OPCIONAL: docker compose funciona sin .env (usa defaults ficticios de desarrollo).
# Copia a .env solo si quieres cambiar valores. NUNCA subas .env a Git.
# Estas variables solo llegan al contenedor `strapi`; el frontend no recibe secretos.

STRAPI_APP_KEYS=fictitiousKeyA123456789,fictitiousKeyB123456789
STRAPI_API_TOKEN_SALT=fictitiousApiTokenSalt123456789
STRAPI_ADMIN_JWT_SECRET=fictitiousAdminJwtSecret123456789
STRAPI_TRANSFER_TOKEN_SALT=fictitiousTransferSalt123456789
STRAPI_JWT_SECRET=fictitiousJwtSecret123456789
STRAPI_ENCRYPTION_KEY=fictitiousEncryptionKey123456789

# Base de datos: sqlite (local, por defecto) | postgres (nube, p. ej. Neon)
DATABASE_CLIENT=sqlite
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Crea datos semilla CO/CL al arrancar si no existen (idempotente, no destructivo)
SEED_ON_BOOT=true
