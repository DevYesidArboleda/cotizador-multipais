# OPCIONAL: docker compose funciona sin .env (docker-compose.yml trae defaults FICTICIOS de desarrollo).
# Copia a .env solo si quieres cambiar valores. NUNCA subas .env a Git.
# Estas variables solo llegan al contenedor `strapi`; el frontend no recibe secretos (ni en build ni en runtime).
# Aqui solo hay marcadores de posicion: gitleaks solo tiene allowlist para docker-compose*.yml (ADR-003).
# Genera valores reales con:  node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"

# STRAPI_APP_KEYS=<dos-claves-separadas-por-coma>
# STRAPI_API_TOKEN_SALT=<aleatorio>
# STRAPI_ADMIN_JWT_SECRET=<aleatorio>
# STRAPI_TRANSFER_TOKEN_SALT=<aleatorio>
# STRAPI_JWT_SECRET=<aleatorio>
# STRAPI_ENCRYPTION_KEY=<aleatorio>

# Super-admin inicial que crea el bootstrap si aun no hay ninguno (ADR-002 §4.2).
# Local: ficticio (ya hay defaults en compose: admin@example.com). Nube: Render Secrets.
# STRAPI_ADMIN_EMAIL=admin@example.com
# STRAPI_ADMIN_PASSWORD=<minimo-8-con-mayuscula-minuscula-y-numero>

# Origen del panel admin; tambien es el UNICO origen que permite strapi::cors (ADR-002 §4.2).
# PUBLIC_URL=http://localhost:1337

# Base de datos: sqlite (local, por defecto) | postgres (nube, p. ej. Neon).
# Para probar Postgres local sin Neon:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up --build
# DATABASE_CLIENT=sqlite
# DATABASE_URL=postgres://<usuario>:<clave>@<host>/<db>?sslmode=require
# DATABASE_SSL=false

# Crea datos semilla CO/CL al arrancar si no existen (idempotente, no destructivo)
# SEED_ON_BOOT=true
